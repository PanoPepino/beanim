# This seems to be a file to ignore specific files and folder to not upload from my computer to github

# Python files
__pycache__/
/env
/build
/dist
*.egg-info/

# Docs
docs/build/

# Manim
tests/example_media/

# Others
.DS_Store

# Sphinx documentation
docs/_build/
docs/.doctrees/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Regenerable Manim and documentation output
**/media/Tex/
**/media/texts/
**/partial_movie_files/
/examples/slides/
/slides/

# Pages publishes curated gallery images only. Keep other renders local.
/docs/_static/media/*
!/docs/_static/media/images/
/docs/_static/media/images/*
